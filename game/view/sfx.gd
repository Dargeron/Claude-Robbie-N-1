extends Node
## Sound for the station and the transmissions (autoload "Sfx").
## Sounds live in res://audio/ (generated by tools/gen_audio.py).

const NAMES := ["launch", "jelly", "sting", "crash", "lurker_wake", "strike", "valve", "laser",
	"exit", "burst", "ui_click", "ui_launch", "blip",
	"drum", "punch", "lever", "thump", "tear", "paper", "type", "switch", "crank", "stamp", "relay", "cover",
	"whistle", "chain", "chuff"]
const POOL := 8

var muted := false
var _streams := {}
var _pool: Array[AudioStreamPlayer] = []
var _next := 0
var _amb_station: AudioStreamPlayer
var _amb_dive: AudioStreamPlayer


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for n in NAMES:
		var s: AudioStream = load("res://audio/%s.wav" % n)
		if s != null:
			_streams[n] = s
	for i in POOL:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_pool.append(p)
	_amb_station = _loop_player("amb_station", -22.0)
	_amb_dive = _loop_player("amb_dive", -80.0)


func _loop_player(name: String, db: float) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	var s: AudioStreamWAV = load("res://audio/%s.wav" % name)
	if s != null:
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = int(s.get_length() * s.mix_rate)
		p.stream = s
	p.volume_db = db
	add_child(p)
	return p


## Ambience starts after the first click (browsers only allow sound after input).
func start_ambience() -> void:
	if not _amb_station.playing:
		_amb_station.play()
	if not _amb_dive.playing:
		_amb_dive.play()


## How loud the dive's underwater rumble is: 0 when nothing plays, 1 while a dive plays.
func set_dive_level(level: float) -> void:
	var target := lerpf(-60.0, -14.0, clampf(level, 0.0, 1.0))
	_amb_dive.volume_db = lerpf(_amb_dive.volume_db, target, 0.08)


func play(name: String, db: float = 0.0, pitch: float = 1.0) -> void:
	if muted or not _streams.has(name):
		return
	var p := _pool[_next]
	_next = (_next + 1) % POOL
	p.stream = _streams[name]
	p.volume_db = db
	p.pitch_scale = pitch
	p.play()


func set_muted(on: bool) -> void:
	muted = on
	AudioServer.set_bus_mute(0, on)
