; Engine configuration file.
; Pinned engine: Godot 4.7.2-stable (see tools/bootstrap.sh)

config_version=5

[application]

config/name="Robbie N+1"
config/description="Program Robbie, send it into Jupiter's dark ocean, watch it die, send the next one."
config/version="0.9.0-induction"
run/main_scene="res://console/operator.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Sfx="*res://view/sfx.gd"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=4

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
